# ==========================================
# FRONTEND DASHBOARD - OPTIONAL ENV VARS
# ==========================================
# NOTE: Frontend uses ~/.databrickscfg for auth
# This .env file is NOT required for dashboard

# Only needed if you want to override default behavior
# DATABRICKS_HOST=https://dbc-eedc1a2c-39d4.cloud.databricks.com
# DATABRICKS_TOKEN=your_token_here

# ==========================================
# BACKEND DATA PIPELINE - REQUIRED ENV VARS
# ==========================================
# These are needed for running the data ingestion pipeline
# (located in ../backend/)

# Kaggle credentials (for data ingestion)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Databricks credentials (for pipeline)
DATABRICKS_HOST=https://dbc-eedc1a2c-39d4.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token

# Kafka credentials (for streaming)
KAFKA_BOOTSTRAP_SERVERS=your_kafka_bootstrap_servers
KAFKA_SASL_USERNAME=your_kafka_username
KAFKA_SASL_PASSWORD=your_kafka_password
KAFKA_TOPIC=ecommerce_events

# ==========================================
# NOTES
# ==========================================
# Frontend dashboard: Only needs ~/.databrickscfg
# Backend pipeline: Needs all variables above
# 
# Your existing .env should have all backend vars already!